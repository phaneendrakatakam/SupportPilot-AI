  {
    "id": "EVAL-V3-001",
    "name": "paid_upgrade_failed_sync_recommends_retry",
    "customer_message": "I paid for Pro, but my account still shows Basic. What happened?",
    "trace": [
      {
        "type": "tool_call",
        "tool": "get_subscription",
        "result_status": "SUCCESS",
        "result": {
          "status": "SUCCESS",
          "customer_id": "CUS-1007",
          "plan": "BASIC",
          "requested_plan": "PRO",
          "subscription_status": "ACTIVE",
          "last_sync_status": "FAILED"
        }
      },
      {
        "type": "tool_call",
        "tool": "get_payment_status",
        "result_status": "SUCCESS",
        "result": {
          "status": "SUCCESS",
          "customer_id": "CUS-1007",
          "payment_id": "PAY-3007",
          "plan": "PRO",
          "payment_status": "SUCCESS",
          "amount": 29,
          "currency": "USD"
        }
      }
    ],
    "expected_resolution_status": "ESCALATION_REQUIRED",
    "expected_issue_type": "subscription_upgrade_failure",
    "expected_action": "retry_subscription_sync",
    "expected_action_customer_id": "CUS-1007",
    "response_contains": [
      "additional support review"
    ],
    "response_not_contains": [
      "your account has been updated"
    ]
  },
